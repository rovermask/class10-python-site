{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": [
      "/admin",
      "/admin/:path*",
      "/quiz/:path*"
    ]
  },
  "redirects": [
    {
      "source": "/quiz",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/visible.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}